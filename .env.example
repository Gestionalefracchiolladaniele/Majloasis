# ── Apify (scraping LinkedIn — NON tocca l'account dell'utente) ──
# Da https://apify.com → Settings → Manage tokens → Personal API token
APIFY_TOKEN=
# (opzionale) override degli Actor. Default = harvestapi (no-cookie, collaudati).
#   APIFY_PROFILE_ACTOR        ricerca profili    → harvestapi~linkedin-profile-search
#   APIFY_PROFILE_DETAIL_ACTOR scrape 1 profilo   → harvestapi~linkedin-profile-scraper
#   APIFY_JOB_ACTOR            ricerca lavori     → harvestapi~linkedin-job-search
# Ricorda: apri ogni Actor una volta su Apify ("Try for free") per autorizzarlo via API.
APIFY_PROFILE_ACTOR=
APIFY_PROFILE_DETAIL_ACTOR=
APIFY_JOB_ACTOR=
# (opzionale) modalità ricerca profili: "Short" (default, ~$0.004/profilo, solo dati base)
# oppure "Full" (~2x, include n. follower → abilita il filtro numerico max_followers).
APIFY_PROFILE_MODE=
# (opzionale) quanti profili/lavori per giro. Default 50/20 (sicuri su Vercel hobby ~60s).
# Per i primi test conviene tenerli bassi (es. 25/10). Su Vercel Pro (300s) puoi alzarli.
COLLECT_PROFILE_LIMIT=
COLLECT_JOB_LIMIT=

# ── Gemini (valutazione + generazione messaggi) ──
# Da https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=

# ── Supabase (database) ──
# Da https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron / sicurezza ──
# Stringa casuale a tua scelta (es. output di: openssl rand -hex 32) per proteggere /api/cron/collect
CRON_SECRET=
# (opzionale) password unica per accedere alla dashboard (no login vero, uso personale)
DASHBOARD_PASSWORD=
